# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env إلى Git أبدًا

# === مفتاح جلسة (إلزامي في الإنتاج) ===
APP_SECRET_KEY=change-me-to-a-long-random-string

# === OAuth (بعد التدوير من Google / GitHub) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Chargily Pay (وضع الاختبار) ===
CHARGILY_KEY=
CHARGILY_SECRET=

# === أمان ===
SESSION_COOKIE_SECURE=true
# CORS_ORIGINS=https://your-domain.com
# MAX_UPLOAD_MB=500

# === اختياري (التحقق بالذكاء الاصطناعي) ===
# LLAMA_CLI=C:\llama.cpp\llama-mtmd-cli.exe
